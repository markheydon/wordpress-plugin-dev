{
  "name": "markheydon/wordpress-plugin-dev",
  "description": "Template repository for modern WordPress plugin development.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "squizlabs/php_codesniffer": "^3.13.4",
    "wp-coding-standards/wpcs": "^3.3"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml",
    "lint:fix": "phpcbf --standard=phpcs.xml",
    "lint:php": "phpcs --standard=phpcs.xml --extensions=php --report=full src",
    "standards": "phpcs -i"
  }
}
